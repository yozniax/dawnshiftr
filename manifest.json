{
  "manifest_version": 3,
  "name": "DAWNSHIFTr",
  "short_name": "DAWNSHIFTr",
  "version": "1.0.0",
  "description": "Bedside internet radio. Station notes, sleep timer, live titles.",
  "homepage_url": "https://github.com/yozniax/dawnshiftr",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "DAWNSHIFTr — play the YouTube tab",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "player.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "offline_enabled": false,
  "permissions": [
    "sidePanel",
    "offscreen",
    "storage",
    "declarativeNetRequest",
    "contextMenus",
    "commands",
    "alarms",
    "tabs",
    "activeTab",
    "scripting"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://m.youtube.com/*",
        "*://music.youtube.com/*",
        "*://www.youtube-nocookie.com/*"
      ],
      "js": ["js/yt-tab.js"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com https://youtube.com https://music.youtube.com"
  },
  "host_permissions": ["<all_urls>"],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "cors",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "commands": {
    "play-pause": {
      "suggested_key": { "default": "MediaPlayPause" },
      "description": "Play / pause"
    },
    "next-track": {
      "suggested_key": { "default": "MediaNextTrack" },
      "description": "Next track"
    },
    "prev-track": {
      "suggested_key": { "default": "MediaPrevTrack" },
      "description": "Previous track"
    },
    "open-player": {
      "suggested_key": { "default": "Ctrl+Shift+P" },
      "description": "Open DAWNSHIFTr"
    }
  }
}
